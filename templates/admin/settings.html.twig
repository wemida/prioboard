{% extends 'base.html.twig' %}

{% block title %}PrioBoard | {{ 'common.settings'|trans }}{% endblock %}
{% block body_class %}admin-screen{% endblock %}

{% block body %}
    <main class="admin-page">
        <header class="admin-header">
            <div><h1>Priority Board</h1></div>
            <nav class="admin-nav"><a class="button" href="{{ path('app_board') }}">{{ 'common.view_board'|trans }}</a></nav>
        </header>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash flash-{{ label == 'error' ? 'error' : 'success' }}">{{ message|trans }}</div>
            {% endfor %}
        {% endfor %}

        <section class="settings-grid">
            <article class="panel">
                <div class="panel-heading">
                    <h2>{{ 'settings.display.title'|trans }}</h2>
                    <p>{{ 'settings.display.description'|trans }}</p>
                </div>
                {{ form_start(settingsForm, { attr: { class: 'stack-form' } }) }}
                    {{ form_row(settingsForm.skin) }}
                    {{ form_row(settingsForm.fontSize) }}
                    {{ form_row(settingsForm.language) }}
                    {{ form_row(settingsForm.refreshInterval) }}
                    {{ form_row(settingsForm.deleteConfirmationEnabled) }}
                    <button class="button button-primary" type="submit">{{ 'settings.display.save'|trans }}</button>
                {{ form_end(settingsForm) }}
            </article>

            <article class="panel">
                <div class="panel-heading">
                    <h2>{{ 'settings.api.title'|trans }}</h2>
                    <p>{{ 'settings.api.description'|trans }}</p>
                </div>
                <div class="stack-form">
                    <label>
                        <span>{{ 'common.api_key'|trans }}</span>
                        <div class="api-key-row">
                            <input type="text" value="{{ settings.apiKey }}" readonly disabled>
                            <form method="post" action="{{ path('app_admin_settings_api_key_regenerate') }}">
                                <button class="button button-primary" type="submit">{{ 'settings.api.generate'|trans }}</button>
                            </form>
                        </div>
                    </label>
                </div>
                <br><br>
                <div class="api-example">
                    <p><strong>{{ 'settings.api.read_board'|trans }}</strong> <code>GET {{ absolute_url(path('api_board')) }}</code></p>
                    <p><strong>{{ 'settings.api.create_card'|trans }}</strong> <code>POST {{ absolute_url(path('api_card_create')) }}</code></p>
                    <a class="button" href="{{ path('app_admin_api_docs') }}">{{ 'settings.api.view_docs'|trans }}</a>
                </div>
            </article>

            <article class="panel">
                <div class="panel-heading">
                    <h2>{{ 'settings.login.title'|trans }}</h2>
                    <p>{{ 'settings.login.description'|trans }}</p>
                </div>
                {{ form_start(accountForm, { attr: { class: 'stack-form' } }) }}
                    {{ form_row(accountForm.username) }}
                    {{ form_row(accountForm.plainPassword) }}
                    <button class="button button-primary" type="submit">{{ 'settings.login.save'|trans }}</button>
                {{ form_end(accountForm) }}
            </article>

            <article class="panel">
                <div class="panel-heading">
                    <h2>{{ 'settings.info.title'|trans }}</h2>
                    <p>{{ 'settings.info.description'|trans }}
                        <br><a href="https://github.com/wemida/prioboard" target="_blank" rel="noopener noreferrer">{{ 'footer.github'|trans }}</a>.</p>
                    <p>{{ 'settings.info.monochrome'|trans }}</p>
                </div>
            </article>
        </section>
    </main>
{% endblock %}
