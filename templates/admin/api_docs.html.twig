{% extends 'base.html.twig' %}

{% block title %}{{ 'api_docs.title'|trans }} | PrioBoard{% endblock %}
{% block body_class %}admin-screen{% endblock %}

{% block body %}
    {% set baseUrl = app.request.schemeAndHttpHost %}
    {% set apiKey = settings.apiKey ?: 'YOUR_API_KEY' %}
    <main class="admin-page api-docs">
        <header class="admin-header">
            <div><h1>{{ 'api_docs.title'|trans }}</h1></div>
            <nav class="admin-nav">
                <a class="button" href="{{ path('app_admin_settings') }}">{{ 'api_docs.back'|trans }}</a>
                <a class="button" href="{{ path('app_board') }}">{{ 'common.view_board'|trans }}</a>
            </nav>
        </header>

        <section class="panel api-docs-intro">
            <div class="panel-heading">
                <h2>{{ 'api_docs.intro.title'|trans }}</h2>
                <p>{{ 'api_docs.intro.description'|trans }}</p>
            </div>
            <dl class="api-facts">
                <div><dt>{{ 'api_docs.base_url'|trans }}</dt><dd><code>{{ baseUrl }}/api</code></dd></div>
                <div><dt>{{ 'api_docs.content_type'|trans }}</dt><dd><code>application/json</code></dd></div>
                <div><dt>{{ 'api_docs.authentication'|trans }}</dt><dd><code>X-API-Key: {{ apiKey }}</code></dd></div>
            </dl>
            <p class="muted">{{ 'api_docs.key_warning'|trans }}</p>
        </section>

        <section class="api-endpoints" aria-label="API endpoints">
            <article class="panel api-endpoint">
                <div class="api-endpoint-heading"><span class="api-method api-method-get">GET</span><h2>/api/board</h2><span class="api-auth">{{ 'api_docs.public'|trans }}</span></div>
                <p>{{ 'api_docs.board.description'|trans }}</p>
                <h3>{{ 'api_docs.request'|trans }}</h3><pre><code>curl "{{ baseUrl }}/api/board"</code></pre>
                <h3>{{ 'api_docs.response_200'|trans }}</h3><pre><code>{
  "settings": {
    "skin": "color",
    "fontSize": "medium",
    "refreshInterval": 30,
    "boardVersion": 12,
    "updatedAt": "2026-07-22T12:00:00+00:00"
  },
  "columns": { "wip": "WIP", "prio1": "Prio 1", "prio2": "Prio 2" },
  "cards": { "wip": [], "prio1": [], "prio2": [] }
}</code></pre>
            </article>

            <article class="panel api-endpoint">
                <div class="api-endpoint-heading"><span class="api-method api-method-get">GET</span><h2>/api/board/meta</h2><span class="api-auth">{{ 'api_docs.public'|trans }}</span></div>
                <p>{{ 'api_docs.meta.description'|trans }}</p>
                <h3>{{ 'api_docs.request'|trans }}</h3><pre><code>curl "{{ baseUrl }}/api/board/meta"</code></pre>
                <h3>{{ 'api_docs.response_200'|trans }}</h3><pre><code>{
  "boardVersion": 12,
  "refreshInterval": 30,
  "updatedAt": "2026-07-22T12:00:00+00:00"
}</code></pre>
            </article>

            <article class="panel api-endpoint">
                <div class="api-endpoint-heading"><span class="api-method api-method-post">POST</span><h2>/api/cards</h2><span class="api-auth">{{ 'common.api_key'|trans }}</span></div>
                <p>{{ 'api_docs.create.description'|trans }}</p>
                <h3>{{ 'api_docs.json_fields'|trans }}</h3>
                <div class="api-table-wrap"><table class="api-table"><thead><tr><th>{{ 'api_docs.field'|trans }}</th><th>{{ 'api_docs.required'|trans }}</th><th>{{ 'api_docs.rules'|trans }}</th></tr></thead><tbody>
                    <tr><td><code>title</code></td><td>{{ 'common.yes'|trans }}</td><td>{{ 'api_docs.rule.title'|trans }}</td></tr>
                    <tr><td><code>column</code></td><td>{{ 'common.no'|trans }}</td><td>{{ 'api_docs.rule.column'|trans }}</td></tr>
                    <tr><td><code>color</code></td><td>{{ 'common.no'|trans }}</td><td>{{ 'api_docs.rule.color'|trans }}</td></tr>
                </tbody></table></div>
                <h3>{{ 'api_docs.request'|trans }}</h3><pre><code>curl -X POST "{{ baseUrl }}/api/cards" \
  -H "Content-Type: application/json" \
  -H "X-API-Key: {{ apiKey }}" \
  -d '{"title":"Prepare release","column":"prio1","color":"blue"}'</code></pre>
                <p><strong>{{ 'api_docs.success'|trans }}</strong> <code>201 Created</code> {{ 'api_docs.success_created'|trans }}</p>
            </article>

            <article class="panel api-endpoint">
                <div class="api-endpoint-heading"><span class="api-method api-method-put">PUT/PATCH</span><h2>/api/cards/{id}</h2><span class="api-auth">{{ 'common.api_key'|trans }}</span></div>
                <p>{{ 'api_docs.update.description'|trans }}</p>
                <h3>{{ 'api_docs.request'|trans }}</h3><pre><code>curl -X PATCH "{{ baseUrl }}/api/cards/42" \
  -H "Content-Type: application/json" \
  -H "X-API-Key: {{ apiKey }}" \
  -d '{"title":"Ship release","color":"green"}'</code></pre>
                <p><strong>{{ 'api_docs.success'|trans }}</strong> <code>200 OK</code> {{ 'api_docs.success_updated'|trans }}</p>
            </article>

            <article class="panel api-endpoint">
                <div class="api-endpoint-heading"><span class="api-method api-method-delete">DELETE</span><h2>/api/cards/{id}</h2><span class="api-auth">{{ 'common.api_key'|trans }}</span></div>
                <p>{{ 'api_docs.delete.description'|trans }}</p>
                <h3>{{ 'api_docs.request'|trans }}</h3><pre><code>curl -X DELETE "{{ baseUrl }}/api/cards/42" \
  -H "X-API-Key: {{ apiKey }}"</code></pre>
                <p><strong>{{ 'api_docs.success'|trans }}</strong> <code>204 No Content</code>.</p>
            </article>

            <article class="panel api-endpoint">
                <div class="api-endpoint-heading"><span class="api-method api-method-post">POST</span><h2>/api/cards/{id}/move/{direction}</h2><span class="api-auth">{{ 'common.api_key'|trans }}</span></div>
                <p>{{ 'api_docs.move.description'|trans }}</p>
                <p><strong>{{ 'api_docs.directions'|trans }}</strong> <code>up</code>, <code>down</code>, <code>wip</code>, <code>prio1</code>, <code>prio2</code>.</p>
                <h3>{{ 'api_docs.request'|trans }}</h3><pre><code>curl -X POST "{{ baseUrl }}/api/cards/42/move/prio2" \
  -H "X-API-Key: {{ apiKey }}"</code></pre>
                <p><strong>{{ 'api_docs.success'|trans }}</strong> <code>200 OK</code> {{ 'api_docs.success_moved'|trans }}</p>
            </article>
        </section>

        <section class="panel api-reference">
            <div class="panel-heading"><h2>{{ 'api_docs.response_reference'|trans }}</h2></div>
            <h3>{{ 'api_docs.card_object'|trans }}</h3><pre><code>{
  "id": 42,
  "title": "Prepare release",
  "column": "prio1",
  "position": 1,
  "color": "blue",
  "updatedAt": "2026-07-22T12:00:00+00:00"
}</code></pre>
            <h3>{{ 'api_docs.errors.title'|trans }}</h3>
            <div class="api-table-wrap"><table class="api-table"><thead><tr><th>{{ 'api_docs.status'|trans }}</th><th>{{ 'api_docs.meaning'|trans }}</th></tr></thead><tbody>
                <tr><td><code>403 Forbidden</code></td><td>{{ 'api_docs.errors.forbidden'|trans }}</td></tr>
                <tr><td><code>404 Not Found</code></td><td>{{ 'api_docs.errors.not_found'|trans }}</td></tr>
                <tr><td><code>422 Unprocessable Content</code></td><td>{{ 'api_docs.errors.validation'|trans }}</td></tr>
            </tbody></table></div>
        </section>
    </main>
{% endblock %}
